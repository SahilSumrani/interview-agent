# Copy to Backend/.env and fill real values. Never commit .env.

GROQ_API_KEY=
MONGO_URI=
JWT_SECRET=change-me
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
TTS_PROVIDER=elevenlabs
TTS_MAX_CHARS=380
PORT=3000

# --- Abuse protection (all optional; defaults shown) ---
# Number of reverse-proxy hops to trust for the client IP. Keep 0 for local dev
# and direct deployments; set to 1 only when nginx / Render / Railway is in front,
# otherwise X-Forwarded-For can be spoofed to bypass the rate limits.
TRUST_PROXY_HOPS=0

# Set to 1 to exempt 127.0.0.1 / ::1 from every rate limit (load tests, demos).
RATE_LIMIT_SKIP_LOCALHOST=0

# General limiter across /api/ — ~10 full interviews per window per IP.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600

# POST /api/voice/sessions — resume parse + 2 Groq calls, the priciest endpoint.
SESSION_RATE_LIMIT_WINDOW_MINUTES=60
SESSION_RATE_LIMIT_MAX=10

# POST /api/voice/tts — spends ElevenLabs credits on cache misses.
TTS_RATE_LIMIT_WINDOW_MINUTES=15
TTS_RATE_LIMIT_MAX=200

# Per-IP daily character budget for TTS. Bounds actual spend, not just request
# count. Set to 0 to disable.
TTS_DAILY_CHAR_BUDGET=60000
